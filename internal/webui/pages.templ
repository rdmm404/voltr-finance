package webui

import "fmt"

templ Shell(title string) {
	<!doctype html>
	<html lang="en-CA">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="theme-color" content="#181825"/>
			<title>{ title } · Voltr Finance</title>
			<link rel="preload" href="/assets/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body>
			<header class="site-header">
				<nav aria-label="Primary" class="shell site-nav">
					<a class="brand" href="/" aria-label="Voltr Finance home">
						<span class="brand-mark" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M13.2 2 4.8 13.1h6.5L10.8 22l8.4-11.1h-6.5L13.2 2Z" fill="currentColor"></path></svg>
						</span>
						<span>Voltr Finance</span>
					</a>
					<span class="private-label">Private dashboard</span>
				</nav>
			</header>
			<main class="shell page">
				{ children... }
			</main>
		</body>
	</html>
}

templ Card(title string) {
	<section class="panel p-2">
		if title != "" {
			<h2 class="mb-1.5">{ title }</h2>
		}
		{ children... }
	</section>
}

templ StateText(state SemanticState) {
	if label := stateLabel(state); label != "" {
		<span class="sr-only">{ label }</span>
	}
}

templ SummaryProgress(summary SummaryView) {
	<div class="summary-progress">
		<div class="summary-progress-label">
			<span>Budget used</span>
			<span>
				@StateText(summary.State)
				<strong>{ summary.Progress }%</strong>
			</span>
		</div>
		<progress value={ summary.Progress } max="100" data-state={ string(summary.State) }>{ summary.Progress }%</progress>
	</div>
}

templ Metric(label, value string, emphasis bool) {
	<div class={ "metric", templ.KV("metric-emphasis", emphasis) }>
		<div class="metric-label">{ label }</div>
		<div class="metric-value">{ value }</div>
	</div>
}

templ SummaryMetrics(summary SummaryView) {
	<div class="metrics-grid" data-state={ string(summary.State) }>
		@Metric("Total budget", summary.Allocation, false)
		@Metric("Spent", summary.Spent, false)
		@Metric("Available", summary.Remaining, true)
	</div>
}

templ TransactionList(items []TransactionView) {
	if len(items) == 0 {
		<p class="empty-copy px-0">No transactions mapped here.</p>
	} else {
		<ul class="transaction-list">
			for _, item := range items {
				<li>
					<div class="transaction-main">
						<p class="transaction-description">{ item.Description }</p>
						<p class="transaction-meta">{ item.Date } · { item.Category } · { item.AuthorName }</p>
						if item.Notes != "" {
							<p class="transaction-notes">{ item.Notes }</p>
						}
					</div>
					<div class="transaction-amount">{ item.Amount }</div>
				</li>
			}
		</ul>
	}
}

templ BudgetLine(line LineView) {
	<details class="budget-line" data-state={ string(line.State) }>
		<summary>
			<div class="line-heading">
				<h3>{ line.Name }</h3>
				@StateText(line.State)
			</div>
			<span class="line-amount"><strong>{ line.Actual }</strong> <span class="sub">of { line.Allocation }</span></span>
			<span class="line-pct">{ line.Progress }%</span>
			<span class="marker" aria-hidden="true"></span>
			if line.Categories != "" {
				<p class="line-categories">{ line.Categories }</p>
			}
			<progress value={ line.Progress } max="100" data-state={ string(line.State) }>{ line.Progress }%</progress>
		</summary>
		<div class="line-detail">
			<div class="remaining-note"><span>Remaining in this line</span><strong>{ line.Remaining }</strong></div>
			@TransactionList(line.Transactions)
		</div>
	</details>
}

templ ScopeReport(scope ScopeView) {
	if scope.Empty {
		<section class="panel scope-panel">
			<header class="scope-head"><h2>{ scope.OwnerName }</h2><span class="label">{ scope.Label } budget</span></header>
			<p class="empty-copy">No budget exists for this scope and month.</p>
		</section>
	} else {
		<section class="panel scope-panel">
			<header class="scope-head"><h2>{ scope.OwnerName }</h2><span class="label">{ scope.Label } budget</span></header>
			@SummaryMetrics(scope.Summary)
			@SummaryProgress(scope.Summary)
			<div class="line-list">
				for _, line := range scope.Lines {
					@BudgetLine(line)
				}
				if len(scope.Unmapped) > 0 {
					<details class="unmapped-line">
						<summary>
							<strong class="unmapped-heading">Unmapped spending</strong>
							<span class="unmapped-amount">{ scope.Summary.Unmapped }</span>
							<span class="marker" aria-hidden="true"></span>
						</summary>
						<div class="line-detail">
							@TransactionList(scope.Unmapped)
						</div>
					</details>
				}
				if len(scope.Lines) == 0 && len(scope.Unmapped) == 0 {
					<p class="empty-copy">No budget lines or transactions yet.</p>
				}
			</div>
		</section>
	}
}

templ DashboardPage(view PageView) {
	@Shell("Monthly dashboard") {
		<section class="page-heading">
			<div>
				<h1>{ view.Month }</h1>
				<p>See where your money went and what is still available.</p>
			</div>
			<nav aria-label="Month" class="month-nav">
				<a href={ templ.SafeURL(view.PreviousURL) } aria-label="Previous month">&lt;</a>
				<span>{ view.MonthValue }</span>
				<a href={ templ.SafeURL(view.NextURL) } aria-label="Next month">&gt;</a>
			</nav>
		</section>
		<details class="panel filter-panel">
			<summary><span><strong>Report owners</strong><small>Personal and household views</small></span><span class="marker" aria-hidden="true"></span></summary>
			<form method="get" action="/" class="owner-form">
				<input type="hidden" name="month" value={ view.MonthValue }/>
				<label>
					Personal owner
					<select name="userId">
						for _, user := range view.Users {
							<option value={ fmt.Sprint(user.ID) } selected?={ selected(user.ID, view.UserID) }>{ user.Name }</option>
						}
					</select>
				</label>
				<label>
					Household owner
					<select name="householdId">
						for _, household := range view.Households {
							<option value={ fmt.Sprint(household.ID) } selected?={ selected(household.ID, view.HouseholdID) }>{ household.Name }</option>
						}
					</select>
				</label>
				<button class="btn" type="submit">Update dashboard</button>
			</form>
		</details>
		if view.AllEmpty {
			@Card("No budgets this month") {
				<p class="sub">Neither selected scope has a budget. Navigate to another month or choose different owners.</p>
			}
		} else {
			<section class="panel" aria-label="Combined monthly summary">
				@SummaryMetrics(view.Combined)
				@SummaryProgress(view.Combined)
			</section>
		}
		<div class="scope-grid">
			@ScopeReport(view.Personal)
			@ScopeReport(view.Household)
		</div>
		<footer class="dashboard-footer"><span>All values in Canadian dollars</span><span>Voltr Finance · { view.MonthValue }</span></footer>
	}
}

templ StatusPage(status int, title, message string) {
	@Shell(title) {
		@Card(fmt.Sprintf("%d · %s", status, title)) {
			<p class="sub">{ message }</p>
			<a class="link mt-1.5 inline-block" href="/">Return to dashboard</a>
		}
	}
}
